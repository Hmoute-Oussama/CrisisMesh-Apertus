# ---- CrisisMesh ----------------------------------------------------------
# No API keys. No external services. The whole pipeline runs offline on a
# laptop. Any value you put here must be safe to commit to .env.example.

# Runtime
CRISISMESH_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./crisismesh.db

# ---- Apertus model serving -------------------------------------------------
# Any OpenAI-compatible server works. We ship llama.cpp as the default because
# it runs on CPU and enforces GBNF-constrained JSON at the token level.
APERTUS_BASE_URL=http://127.0.0.1:8090
APERTUS_MODEL_ID=apertus-v1.1-4b-instruct-q4km
APERTUS_MODEL_LABEL=Apertus-v1.1-4B-Instruct
APERTUS_QUANT=Q4_K_M
APERTUS_FAMILY=Apertus
APERTUS_LICENSE=Apache-2.0
# Escalation tier for ambiguous / injection-flagged / multi-incident reports.
# Only one model is loaded at a time; see scripts/start_apertus.ps1
APERTUS_ESCALATION_ID=apertus-8b-instruct-2509-q4km
APERTUS_ESCALATION_LABEL=Apertus-8B-Instruct-2509

# Serving
APERTUS_HOST=127.0.0.1
APERTUS_PORT=8090
APERTUS_THREADS=12
APERTUS_CTX=8192

# Generation - deterministic by design. Do not raise temperature.
# NOTE: the official Apertus card recommends temperature 0.8 / top_p 0.9 for
# general chat. We deviate deliberately: CrisisMesh needs reproducible
# extraction. See docs/MODEL_CARD.md "Deviations".
APERTUS_TEMPERATURE=0.0
APERTUS_TOP_P=1.0
APERTUS_MAX_TOKENS=300
APERTUS_TIMEOUT_S=600

# ---- Prompt versions -------------------------------------------------------
# Bump these when prompt files change. Recorded in audit_log for every event.
PROMPT_VERSION_EXTRACTION=extraction_v2
PROMPT_VERSION_CONFLICT=conflict_v1
PROMPT_VERSION_NORMALIZATION=normalization_v1

# ---- Pipeline tuning -------------------------------------------------------
# Reports below this extraction score stay unverified regardless of count.
EVIDENCE_CONFIDENCE_FLOOR=0.45
# Similarity above which two reports are treated as duplicates, not corroboration.
DEDUP_STRONG_THRESHOLD=0.92
DEDUP_REVIEW_THRESHOLD=0.72
# Status pairs that constitute a contradiction.
CONFLICT_STATUS_PAIRS=road_blocked:road_open,power_outage:power_restored,water_outage:water_restored,fire:no_fire
# Operator token for verify/resolve endpoints. Empty disables the guard.
OPERATOR_TOKEN=crisismesh-dev-operator
RETENTION_DAYS=30